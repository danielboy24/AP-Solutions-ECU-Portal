# Railway PostgreSQL service reference (set in Railway Variables)
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
# Private S3-compatible bucket (e.g. Cloudflare R2). Never make it public.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ap-solutions-ecu-private
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false
# Shopify webhook integration: logging verified orders only; credits NOT automatically awarded
SHOPIFY_SHOP_DOMAIN=espqp7-e1.myshopify.com
SHOPIFY_WEBHOOK_SECRET=REPLACE_WITH_APP_WEBHOOK_SECRET
# Only for one-time admin bootstrap, remove afterwards
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ADMIN_NAME=AP Solutions
